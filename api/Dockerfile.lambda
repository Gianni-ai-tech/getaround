# Image pour AWS Lambda (même code que l'image Docker classique, servi par Mangum)
FROM public.ecr.aws/lambda/python:3.13
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt mangum==0.19.0
COPY app.py lambda_handler.py docs.html model.joblib ${LAMBDA_TASK_ROOT}/
CMD ["lambda_handler.handler"]
